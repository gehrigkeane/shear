<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only ever used for explicit, user-enabled redirect resolution. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets Shear resolve the label and icon of whatever app the user picked in the Sharesheet. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <!-- Share history is private and stays on this device; it is never backed up or transferred off it. -->
    <application
        android:name=".ShearApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shear">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The share target. Translucent and usually invisible; it relays to the native Sharesheet and finishes. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboardHidden"
            android:theme="@style/Theme.Shear.Relay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Hears which app the user picked in the Sharesheet and attaches it to the history event. -->
        <receiver
            android:name=".ChosenComponentReceiver"
            android:exported="false" />
    </application>
</manifest>
